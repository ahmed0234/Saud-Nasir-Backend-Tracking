# Neon connection string (Neon console → Connect → pooled connection)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Comma-separated WordPress origins (scheme + host, no path or trailing slash).
# Also read at build time for SvelteKit's CSRF check, so redeploy after changing it.

# Dashboard sign-in. Every page except /login and the tracking endpoint requires it.
# Without all three (or with a password under 12 / secret under 32 characters) nobody can sign in;
# tracking keeps working either way. Changing the password or the secret signs everyone out.
AUTH_USERNAME="admin"
AUTH_PASSWORD="use-a-long-unique-password"
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-at-least-32-random-characters"
