# Neon connection string (Neon console → Connect → pooled connection)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Comma-separated WordPress origins (scheme + host, no path or trailing slash).
# Also read at build time for SvelteKit's CSRF check, so redeploy after changing it.
CORS_ALLOWED_ORIGINS="https://www.platinumsg.com,https://www.cleanmastercarpetcleaning.com,https://www.emgair.com"

# Gmail account that sends notifications, and its Google App Password
# (Google Account → Security → 2-Step Verification → App passwords)
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Comma-separated recipient(s) of CTA click notification emails
NOTIFICATION_EMAIL_TO="ahmedkiller0234@gmail.com"
